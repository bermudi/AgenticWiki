#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Prove mechanical closure of one exact fix spec against the staged blob.

A fix spec is `exact current text -> exact replacement text` for one wiki
path. The spec is mechanically closed when, inside `git show :<path>`:

  - the current text occurs 0 times (non-overlapping, byte-exact), and
  - the replacement text occurs exactly 1 time.

Both strings are supplied as files (write them with a quoted heredoc), so
apostrophes, quotes, and multi-line text need no shell escaping. Each file's
content is used verbatim except that one trailing newline added by a heredoc
or editor is ignored.

Exit codes: 0 = closed, 1 = open (counts printed), 2 = usage/spec error.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path


class SpecError(RuntimeError):
    """The spec itself is malformed; the check cannot run."""


def read_pattern(path: str, label: str) -> bytes:
    file = Path(path)
    try:
        data = file.read_bytes()
    except OSError as exc:
        raise SpecError(f"cannot read {label} file {path!r}: {exc}") from exc
    # Tolerate exactly one trailing newline appended by a heredoc or editor.
    if data.endswith(b"\n"):
        data = data[:-1]
    if not data:
        raise SpecError(f"{label} text is empty after trailing-newline tolerance: {path!r}")
    return data


def staged_blob(path: str) -> bytes:
    try:
        result = subprocess.run(
            ["git", "show", f":{path}"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        raise SpecError(f"cannot execute git: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip() or f"exit {result.returncode}"
        raise SpecError(f"cannot read staged blob for {path!r}: {detail}")
    return result.stdout


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="fix-spec-check",
        description="Count non-overlapping byte-exact occurrences of the spec's two strings in the staged blob.",
    )
    parser.add_argument("path", help="repository path whose staged blob is checked")
    parser.add_argument("--current", required=True, help="file containing the exact current text")
    parser.add_argument("--replacement", required=True, help="file containing the exact replacement text")
    args = parser.parse_args(argv)

    try:
        current = read_pattern(args.current, "current")
        replacement = read_pattern(args.replacement, "replacement")
        if current == replacement:
            raise SpecError("current and replacement texts are identical (no-op spec)")
        if replacement.count(current) > 0:
            raise SpecError(
                "current text survives inside its own replacement — such a spec can never "
                "close; extend the correction so the old text is fully replaced"
            )
        blob = staged_blob(args.path)
    except SpecError as exc:
        print(f"fix-spec-check: {exc}", file=sys.stderr)
        return 2

    current_count = blob.count(current)
    replacement_count = blob.count(replacement)
    closed = current_count == 0 and replacement_count == 1
    print(
        f"FIX_SPEC={'CLOSED' if closed else 'OPEN'} path={args.path} "
        f"current_occurrences={current_count} replacement_occurrences={replacement_count} "
        f"current_bytes={len(current)} replacement_bytes={len(replacement)}"
    )
    return 0 if closed else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
