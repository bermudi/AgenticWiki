#!/usr/bin/env bash
# Regression tests for scripts/filing-baton using isolated temporary repositories.
#
# The baton enforces only the write -> review -> commit state machine. Commands
# are run directly (no session identity machinery), and parallel tests use
# background shell processes.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BATON="$SCRIPT_DIR/filing-baton"
CHECK="$SCRIPT_DIR/filing-check"
TMP_ROOT=$(mktemp -d)
ORIGINAL_PWD=$PWD
trap 'cd "$ORIGINAL_PWD"; rm -rf "$TMP_ROOT"' EXIT

PASS=0
FAIL=0

ok() {
  PASS=$((PASS + 1))
  printf 'ok %d - %s\n' "$PASS" "$1"
}

not_ok() {
  FAIL=$((FAIL + 1))
  printf 'not ok - %s\n' "$1" >&2
}

expect_success() {
  local description="$1"
  shift
  if "$@" >$TMP_ROOT/output 2>&1; then
    ok "$description"
  else
    not_ok "$description"
    cat $TMP_ROOT/output >&2
  fi
}

expect_failure() {
  local description="$1"
  shift
  if "$@" >$TMP_ROOT/output 2>&1; then
    not_ok "$description (unexpected success)"
  else
    ok "$description"
  fi
}

new_repo() {
  REPO="$TMP_ROOT/$1"
  mkdir -p "$REPO/scripts" "$REPO/wiki"
  git -C "$REPO" init -q
  git -C "$REPO" config user.name baton-test
  git -C "$REPO" config user.email baton@example.invalid
  cp "$BATON" "$REPO/scripts/filing-baton"
  cp "$CHECK" "$REPO/scripts/filing-check"
  chmod +x "$REPO/scripts/filing-baton" "$REPO/scripts/filing-check"
  cat >"$REPO/scripts/validate-page" <<'VALIDATOR'
#!/usr/bin/env bash
set -euo pipefail
if [ -e validator-fail ]; then
  printf 'STATUS: CHANGED_SCOPE_ERRORS\n'
  exit 1
fi
printf 'STATUS: CHANGED_SCOPE_CLEAN\n'
VALIDATOR
  chmod +x "$REPO/scripts/validate-page"
  cat >"$REPO/.gitignore" <<'IGNORE'
.filing-handoff/
IGNORE
  printf '# fixture\n' >"$REPO/README.md"
  printf '# Wiki index\n' >"$REPO/wiki/index.md"
  git -C "$REPO" add README.md .gitignore wiki/index.md scripts/filing-baton scripts/filing-check scripts/validate-page
  git -C "$REPO" commit -qm fixture
  cd "$REPO"
}

new_repo common-check-failure
expect_success "write pass starts for common-check failure fixture" \
  bash -c 'scripts/filing-baton start-write --source check-source --locator raw/check.md --filing-date 2026-08-06'
mkdir -p raw
printf 'trailing whitespace \n' >raw/check.md
git add -- raw/check.md
expect_success "restart-write adopts mechanically invalid partial staged work" \
  bash -c 'scripts/filing-baton restart-write --source check-source --reason "resume partial writer"'
expect_failure "finish-write fails when the common filing-check fails" \
  bash -c 'scripts/filing-baton finish-write --source check-source --path raw/check.md'
if grep -q 'filing-check failed' "$TMP_ROOT/output"; then
  ok "baton reports the common checker failure"
else
  not_ok "baton did not identify the common checker failure"
fi

new_repo preexisting-index
printf 'unrelated\n' >unrelated.txt
git add -- unrelated.txt
expect_failure "new write transaction rejects a pre-existing staged index" \
  bash -c 'scripts/filing-baton start-write --source preexisting-source --locator raw/preexisting.md --filing-date 2026-08-06'

new_repo happy

expect_failure "baton rejects the removed agent-supplied --session identity argument" \
  scripts/filing-baton start-write --source bad-session --locator https://example.com \
  --filing-date 2026-08-06 --session .freebuff/session-write-A.log

expect_failure "write pass rejects a non-ISO filing date" \
  scripts/filing-baton start-write --source bad-date --locator https://example.com \
  --filing-date 08-06-2026

expect_success "write pass starts with an empty index" \
  bash -c 'scripts/filing-baton start-write --source example-source --locator https://example.com --filing-date 2026-08-06'

expect_failure "a second slug cannot start while another baton transaction owns the index" \
  bash -c 'scripts/filing-baton start-write --source overlapping-source --locator https://example.org --filing-date 2026-08-06'

mkdir -p raw wiki/topics
cat >raw/example-source.md <<'EOF_RAW'
---
type: web
filed: 2026-08-06
---
source
EOF_RAW
cat >wiki/topics/example.md <<'EOF_WIKI'
---
updated: 2026-08-06
---
page
EOF_WIKI
printf '\n- [[example]]\n' >>wiki/index.md
git add -- raw/example-source.md wiki/topics/example.md wiki/index.md

expect_failure "write pass rejects a staged path omitted from its explicit boundary" \
  bash -c 'scripts/filing-baton finish-write --source example-source --path raw/example-source.md'

expect_success "write pass snapshots staged index entries and requires review" \
  bash -c 'scripts/filing-baton finish-write --source example-source --path raw/example-source.md --path wiki/topics/example.md --path wiki/index.md'
if grep -q 'MECHANICAL_CHECK=PASS scope=staged' .filing-handoff/example-source.json; then
  ok "baton history preserves the common mechanical summary"
else
  not_ok "baton history omitted the common mechanical summary"
fi

if scripts/filing-baton handoff --source example-source >"$TMP_ROOT/handoff-summary" && \
  grep -q 'FREEBUFF FILING HANDOFF' "$TMP_ROOT/handoff-summary" && \
  grep -q 'Recorded state: needs_review' "$TMP_ROOT/handoff-summary" && \
  grep -q 'Repository:' "$TMP_ROOT/handoff-summary" && \
  grep -q 'Handoff file: .filing-handoff/example-source.json' "$TMP_ROOT/handoff-summary" && \
  grep -q 'start-review --source example-source' "$TMP_ROOT/handoff-summary" && \
  grep -q 'Load .agents/skills/coordinating-filing/SKILL.md' "$TMP_ROOT/handoff-summary" && \
  grep -q 'on-disk handoff and Git index are authoritative' "$TMP_ROOT/handoff-summary" && \
  grep -q 'paste the entire previous response verbatim' "$TMP_ROOT/handoff-summary" && \
  grep -q '"boundary"' "$TMP_ROOT/handoff-summary" && \
  ! grep -q 'process ancestry' "$TMP_ROOT/handoff-summary" && \
  ! grep -q '.freebuff/session' "$TMP_ROOT/handoff-summary"; then
  ok "generated handoff is a self-contained verbatim continuation summary with no marker-file instructions"
else
  not_ok "generated handoff is missing continuation context"
fi

expect_success "fresh review session starts" \
  bash -c 'scripts/filing-baton start-review --source example-source'

expect_failure "clean result requires all four reviewer rows" \
  bash -c "scripts/filing-baton finish-review --source example-source --result clean --review theory=PASS --note 'review evidence fixture'"

expect_failure "clean result rejects pass-prefixed and illegal carried statuses" \
  bash -c "scripts/filing-baton finish-review --source example-source --result clean \
  --review 'theory=CARRIED: FAIL' --review 'diff=PASS WITH EXPLICIT PROCESS DEBT' \
  --review 'source-fidelity=PASSING' --review 'quality=SKIPPED-' --note 'review evidence fixture'"

chmod +x wiki/topics/example.md
git add -- wiki/topics/example.md
expect_failure "a mode-only staged-index change cannot be called clean" \
  bash -c "scripts/filing-baton finish-review --source example-source --result clean \
  --review theory=PASS --review diff=PASS --review source-fidelity=PASS --review quality=PASS \
  --note 'review evidence fixture'"

git restore --staged -- raw/example-source.md
expect_failure "a fixer cannot remove a required raw artifact from the transaction" \
  bash -c "scripts/filing-baton finish-review --source example-source --result changed \
  --note 'attempted raw removal'"
git add -- raw/example-source.md

expect_success "review fixes force another fresh review" \
  bash -c "scripts/filing-baton finish-review --source example-source --result changed --note 'fixed example'"

expect_success "second fresh review starts" \
  bash -c 'scripts/filing-baton start-review --source example-source'

expect_failure "clean review refuses an empty evidence note" \
  bash -c "scripts/filing-baton finish-review --source example-source --result clean \
  --review 'theory=PASS' --review diff=PASS \
  --review source-fidelity=PASS --review quality=PASS"

expect_success "zero-delta complete review unlocks commit" \
  bash -c "scripts/filing-baton finish-review --source example-source --result clean \
  --review 'theory=PASS' --review diff=PASS \
  --review source-fidelity=PASS --review quality=PASS --note 'all four reviewer reports clean'"

approved_tree=$(git write-tree)
cp .filing-handoff/example-source.json "$TMP_ROOT/example-approved-state.json"
cat >.git/hooks/pre-commit <<'HOOK'
#!/usr/bin/env bash
printf 'hook contamination\n' >hook-added.txt
git add -- hook-added.txt
exit 1
HOOK
chmod +x .git/hooks/pre-commit

expect_success "approving zero-delta session commits exact staged boundary without hooks" \
  bash -c "scripts/filing-baton commit --source example-source --message 'file: example source'"

if [ ! -e hook-added.txt ] && [ -z "$(git diff --cached --name-only)" ] && \
  [ "$(git log -1 --pretty=%s)" = "file: example source" ] && \
  [ "$(git rev-parse 'HEAD^{tree}')" = "$approved_tree" ]; then
  ok "atomic exact-tree commit clears the staged boundary and records the exact approved tree"
else
  not_ok "commit state is incorrect"
fi

if scripts/filing-baton handoff --source example-source >"$TMP_ROOT/terminal-receipt" && \
  grep -q 'TERMINAL RECEIPT' "$TMP_ROOT/terminal-receipt" && \
  grep -q 'This filing is complete' "$TMP_ROOT/terminal-receipt" && \
  ! grep -q 'paste the entire previous response verbatim' "$TMP_ROOT/terminal-receipt"; then
  ok "committed transaction emits a terminal receipt with no continuation instruction"
else
  not_ok "terminal receipt is missing or still instructs another paste cycle"
fi

cp "$TMP_ROOT/example-approved-state.json" .filing-handoff/example-source.json
expect_success "reconcile-commit recovers an exact approved commit after handoff persistence failure" \
  scripts/filing-baton reconcile-commit --source example-source

new_repo immutable-raw
mkdir -p raw
printf 'original\n' >raw/existing.md
git add -- raw/existing.md
git commit -qm 'add immutable raw fixture'
bash -c 'scripts/filing-baton start-write --source immutable-source --locator raw/existing.md --filing-date 2026-08-06' >/dev/null
printf 'modified\n' >raw/existing.md
git add -- raw/existing.md
expect_failure "write pass rejects modification of an existing raw artifact" \
  bash -c "scripts/filing-baton finish-write --source immutable-source --path raw/existing.md"
expect_success "abort unstages an unrecoverable transaction while preserving worktree files" \
  bash -c "scripts/filing-baton abort --source immutable-source --reason 'immutable raw violation'"
if [ -z "$(git diff --cached --name-only)" ] && [ "$(cat raw/existing.md)" = modified ]; then
  ok "abort clears index ownership without discarding worktree content"
else
  not_ok "abort did not preserve the expected worktree state"
fi

new_repo missing-index
bash -c 'scripts/filing-baton start-write --source index-source --locator raw/index.md --filing-date 2026-08-06' >/dev/null
mkdir -p wiki/concepts
printf 'new page\n' >wiki/concepts/new-page.md
git add -- wiki/concepts/new-page.md
expect_failure "new wiki pages require wiki/index.md in the staged boundary" \
  bash -c "scripts/filing-baton finish-write --source index-source --path wiki/concepts/new-page.md"
printf '\nUnrelated index edit\n' >>wiki/index.md
git add -- wiki/index.md
expect_failure "staging wiki/index.md is insufficient when the new page is not cataloged" \
  bash -c "scripts/filing-baton finish-write --source index-source --path wiki/concepts/new-page.md --path wiki/index.md"

new_repo existing-page-index
printf 'existing page\n' >wiki/existing.md
git add -- wiki/existing.md
git commit -qm 'add existing wiki page fixture'
bash -c 'scripts/filing-baton start-write --source existing-page-source --locator raw/source.md --filing-date 2026-08-06' >/dev/null
printf 'changed page\n' >wiki/existing.md
git add -- wiki/existing.md
expect_failure "existing wiki page changes also require staged wiki/index.md" \
  bash -c "scripts/filing-baton finish-write --source existing-page-source --path wiki/existing.md"

new_repo no-change
mkdir -p raw
printf 'existing source\n' >raw/existing-source.md
git add -- raw/existing-source.md
git commit -qm 'add existing source fixture'
bash -c 'scripts/filing-baton start-write --source no-change-source --locator raw/existing-source.md --filing-date 2026-08-06' >/dev/null
expect_success "existing raw skip can terminate as no-change without review or commit" \
  bash -c "scripts/filing-baton finish-write --source no-change-source --no-change --note 'archive already tracked'"

new_repo dirty-untracked
bash -c 'scripts/filing-baton start-write --source dirty-source --locator raw/dirty.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw wiki/concepts
printf 'source\n' >raw/dirty.md
printf 'page with [[unstaged-helper]]\n' >wiki/concepts/dirty.md
printf '\n- [[dirty]]\n' >>wiki/index.md
printf 'unstaged helper\n' >wiki/concepts/unstaged-helper.md
git add -- raw/dirty.md wiki/concepts/dirty.md wiki/index.md
expect_failure "write completion rejects untracked wiki files outside the staged tree" \
  bash -c "scripts/filing-baton finish-write --source dirty-source --path raw/dirty.md --path wiki/concepts/dirty.md --path wiki/index.md"

new_repo dirty-ignored
printf 'raw/assets/*.pdf\n' >>.gitignore
git add -- .gitignore
git commit -qm 'ignore PDF fixture'
bash -c 'scripts/filing-baton start-write --source dirty-ignored-source --locator raw/source.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw/assets
printf 'source\n' >raw/source.md
printf 'ignored companion\n' >raw/assets/unapproved.pdf
git add -- raw/source.md
expect_failure "write completion rejects ignored raw assets outside the staged tree" \
  bash -c "scripts/filing-baton finish-write --source dirty-ignored-source --path raw/source.md"

new_repo dirty-raw
mkdir -p raw
printf 'preserved\n' >raw/preserved.md
git add -- raw/preserved.md
git commit -qm 'add preserved raw fixture'
bash -c 'scripts/filing-baton start-write --source dirty-raw-source --locator raw/new.md --filing-date 2026-08-06' >/dev/null
printf 'new\n' >raw/new.md
printf 'unstaged mutation\n' >raw/preserved.md
git add -- raw/new.md
expect_failure "write completion rejects unstaged existing-raw changes outside the staged tree" \
  bash -c "scripts/filing-baton finish-write --source dirty-raw-source --path raw/new.md"

new_repo stale
bash -c 'scripts/filing-baton start-write --source stale-source --locator raw/stale.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw
printf 'one\n' >raw/stale.md
git add -- raw/stale.md
bash -c 'scripts/filing-baton finish-write --source stale-source --path raw/stale.md' >/dev/null
printf 'two\n' >raw/stale.md
git add -- raw/stale.md
expect_failure "review refuses a staged boundary that no longer matches the handoff" \
  bash -c 'scripts/filing-baton start-review --source stale-source'

new_repo head-drift
bash -c 'scripts/filing-baton start-write --source head-source --locator raw/head.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw
printf 'head\n' >raw/head.md
git add -- raw/head.md
bash -c 'scripts/filing-baton finish-write --source head-source --path raw/head.md' >/dev/null
old_head=$(git rev-parse HEAD)
head_index="$TMP_ROOT/head-drift-index"
GIT_INDEX_FILE="$head_index" git read-tree "$old_head"
head_blob=$(printf 'concurrent head content\n' | git hash-object -w --stdin)
GIT_INDEX_FILE="$head_index" git update-index --add --cacheinfo "100644,$head_blob,concurrent-head.txt"
new_tree=$(GIT_INDEX_FILE="$head_index" git write-tree)
new_head=$(printf 'concurrent move\n' | git commit-tree "$new_tree" -p "$old_head")
git update-ref "$(git symbolic-ref HEAD)" "$new_head" "$old_head"
expect_failure "review refuses branch HEAD drift after the write handoff" \
  bash -c 'scripts/filing-baton start-review --source head-source'
expect_success "abort can terminalize an exact owned boundary after HEAD drift" \
  bash -c "scripts/filing-baton abort --source head-source --reason 'concurrent HEAD movement'"
mv raw/head.md "$TMP_ROOT/aborted-head-worktree.md"
expect_success "a new transaction can start after drift-safe abort once preserved work is separated" \
  bash -c 'scripts/filing-baton start-write --source after-drift-source --locator raw/after.md --filing-date 2026-08-06'

new_repo blocked
bash -c 'scripts/filing-baton start-write --source blocked-source --locator raw/blocked.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw
printf 'blocked\n' >raw/blocked.md
git add -- raw/blocked.md
bash -c 'scripts/filing-baton finish-write --source blocked-source --path raw/blocked.md' >/dev/null
bash -c 'scripts/filing-baton start-review --source blocked-source' >/dev/null
touch validator-fail
expect_success "blocked result persists even when deterministic validation fails" \
  bash -c "scripts/filing-baton finish-review --source blocked-source --result blocked --note 'validator failure'"
if grep -q 'blocked check: filing-check failed' .filing-handoff/blocked-source.json; then
  ok "blocked review history records the common checker failure"
else
  not_ok "blocked review history omitted the common checker failure"
fi
expect_success "review pass restarts a blocked review while content validation remains broken" \
  bash -c "scripts/filing-baton restart-review --source blocked-source --reason 'repair validation blocker'"
mv validator-fail "$TMP_ROOT/blocked-validator-fail"
expect_success "blocked recovery may record another blocked pass after validation is repaired" \
  bash -c "scripts/filing-baton finish-review --source blocked-source --result blocked --note 'recovery fixture'"
# Test that restart-review rejects untracked wiki/raw bytes before judgment
printf 'untracked review contaminant\n' >wiki/untracked-review.md
expect_failure "restart-review rejects untracked wiki/raw bytes before judgment" \
  bash -c "scripts/filing-baton restart-review --source blocked-source --reason 'blocker resolved'"
mv wiki/untracked-review.md "$TMP_ROOT/untracked-review.md"
expect_success "fresh session can restart a blocked review" \
  bash -c "scripts/filing-baton restart-review --source blocked-source --reason 'blocker resolved'"
printf 'mutation before restart\n' >>raw/blocked.md
git add -- raw/blocked.md
expect_failure "restart-review cannot adopt changes made before the fresh pass is bounded" \
  bash -c "scripts/filing-baton restart-review --source blocked-source --reason 'must not adopt own bytes'"

new_repo blocked-whitespace
bash -c 'scripts/filing-baton start-write --source whitespace-source --locator raw/whitespace.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw
printf 'clean\n' >raw/whitespace.md
git add -- raw/whitespace.md
bash -c 'scripts/filing-baton finish-write --source whitespace-source --path raw/whitespace.md' >/dev/null
bash -c 'scripts/filing-baton start-review --source whitespace-source' >/dev/null
printf 'bad trailing space \n' >raw/whitespace.md
git add -- raw/whitespace.md
expect_success "blocked result records a staged whitespace failure" \
  bash -c "scripts/filing-baton finish-review --source whitespace-source --result blocked --note 'whitespace failure'"
expect_success "fresh review can restart from a blocked invalid boundary and fix it" \
  bash -c "scripts/filing-baton restart-review --source whitespace-source --reason 'repair blocked boundary'"
printf 'fixed\n' >raw/whitespace.md
git add -- raw/whitespace.md
expect_success "recovery fixer records repaired boundary for another fresh review" \
  bash -c "scripts/filing-baton finish-review --source whitespace-source --result changed --note 'fixed whitespace'"

new_repo concurrent
bash -c 'scripts/filing-baton start-write --source concurrent-source --locator raw/concurrent.md --filing-date 2026-08-06' >/dev/null
mkdir -p raw
printf 'concurrent\n' >raw/concurrent.md
git add -- raw/concurrent.md
bash -c 'scripts/filing-baton finish-write --source concurrent-source --path raw/concurrent.md' >/dev/null
(
  bash -c 'scripts/filing-baton start-review --source concurrent-source' >"$TMP_ROOT/concurrent-a" 2>&1
) &
pid_a=$!
(
  bash -c 'scripts/filing-baton start-review --source concurrent-source' >"$TMP_ROOT/concurrent-b" 2>&1
) &
pid_b=$!
code_a=0; wait $pid_a || code_a=$?
code_b=0; wait $pid_b || code_b=$?
if [ "$((code_a + code_b))" -ne 0 ] && [ $((code_a * code_b)) -eq 0 ]; then
  ok "repository-local lock serializes concurrent start-review transitions"
else
  not_ok "concurrent transitions should produce exactly one success"
fi

printf '1..%d\n' "$((PASS + FAIL))"
if [ "$FAIL" -ne 0 ]; then
  exit 1
fi
